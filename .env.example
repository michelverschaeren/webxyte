# ─────────────────────────────────────────────────────────────
# Database (Dokploy PostgreSQL)
# ─────────────────────────────────────────────────────────────
# LOKAAL (migraties draaien vanaf je eigen machine):
#   Gebruik het publieke adres van je Dokploy Postgres-service.
#   In Dokploy: Database → jouw Postgres → "External Credentials".
#   Zet de poort open onder "External Port" (bv. 5432).
DATABASE_URL="postgresql://gebruiker:wachtwoord@vps.jouwdomein.be:5432/databank"

# IN PRODUCTIE (de Nuxt-container draait in hetzelfde Docker-netwerk):
#   Gebruik de INTERNE hostname van de database-service, niet het publieke adres.
#   Dat is sneller en de poort hoeft niet naar buiten open te staan.
# DATABASE_URL="postgresql://vermeir:SUPERGEHEIM@vermeir-db-abc123:5432/vermeir"

# ─────────────────────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────────────────────
# Genereer met: openssl rand -base64 32
# (of PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})))
BETTER_AUTH_SECRET="vervang-mij-door-een-random-string-van-32-bytes"

# Publieke basis-URL van de app. Lokaal http://localhost:3000,
# in productie de echte domeinnaam (https).
BETTER_AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Inloggen met Google / Microsoft (optioneel)
# ─────────────────────────────────────────────────────────────
# Zolang een paar (clientId + secret) leeg is, blijft die knop gewoon
# onzichtbaar/inactief — de site werkt prima met alleen e-mail/wachtwoord.
#
# Google: console.cloud.google.com → APIs & Services → Credentials →
#   Create OAuth client ID (type "Web application"). Voeg als
#   "Authorized redirect URI" toe:
#     http://localhost:3000/api/auth/callback/google   (lokaal)
#     https://<jouw-domein>/api/auth/callback/google    (productie)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
#
# Microsoft: portal.azure.com → Microsoft Entra ID → App registrations →
#   New registration. Voeg onder "Redirect URI" (platform: Web) toe:
#     http://localhost:3000/api/auth/callback/microsoft (lokaal)
#     https://<jouw-domein>/api/auth/callback/microsoft  (productie)
#   Client ID staat op de Overview-pagina; het secret maak je aan onder
#   "Certificates & secrets" → New client secret (kopieer meteen de
#   "Value", die is nadien niet meer zichtbaar).
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" (standaard) laat zowel werk/school- als privé-accounts toe.
# MICROSOFT_TENANT_ID="common"

# ─────────────────────────────────────────────────────────────
# E-mail bij nieuwe bestellingen (Brevo)
# ─────────────────────────────────────────────────────────────
# Optioneel: zolang deze leeg zijn wordt er geen mail verstuurd
# (de bestelling wordt wél gewoon opgeslagen).
# Sleutel: Brevo → SMTP & API → API Keys (v3).
BREVO_API_KEY=""
# Adres van de zaak dat de bestelmelding ontvangt:
# Afzender; moet in Brevo een geverifieerde sender/domein zijn:
BREVO_FROM_EMAIL="info@xyte.be"
BREVO_FROM_NAME="Bestellingen Vermeir"
ORDER_NOTIFICATION_EMAIL="michel@xyte.be"

# ─────────────────────────────────────────────────────────────
# Bestaande app-config
# ─────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_PASSWORD="vermeir2026"
