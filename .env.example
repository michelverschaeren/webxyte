# ─────────────────────────────────────────────────────────────
# Database (Dokploy PostgreSQL)
# ─────────────────────────────────────────────────────────────
# LOKAAL (migraties draaien vanaf je eigen machine):
#   Gebruik het publieke adres van je Dokploy Postgres-service.
#   In Dokploy: Database → jouw Postgres → "External Credentials".
#   Zet de poort open onder "External Port" (bv. 5432).
DATABASE_URL="postgresql://gebruiker:wachtwoord@vps.jouwdomein.be:5432/databank"

# IN PRODUCTIE (de Nuxt-container draait in hetzelfde Docker-netwerk):
#   Gebruik de INTERNE hostname van de database-service, niet het publieke adres.
#   Dat is sneller en de poort hoeft niet naar buiten open te staan.
# DATABASE_URL="postgresql://vermeir:SUPERGEHEIM@vermeir-db-abc123:5432/vermeir"

# ─────────────────────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────────────────────
# Genereer met: openssl rand -base64 32
# (of PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})))
BETTER_AUTH_SECRET="vervang-mij-door-een-random-string-van-32-bytes"

# Publieke basis-URL van de app. Lokaal http://localhost:3000,
# in productie de echte domeinnaam (https).
BETTER_AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# E-mail (Lettermint): bestelmeldingen + inloglinks
# ─────────────────────────────────────────────────────────────
# Optioneel lokaal: zolang deze leeg zijn wordt er geen mail verstuurd
# (bestellingen worden wél opgeslagen; inloglinks komen in de serverlog).
# In productie verplicht, anders werken inloglink/wachtwoord vergeten niet.
# Token: Lettermint → Projects → <project> → API Tokens (Project API token).
# Geheim: nooit in client-code of een NUXT_PUBLIC_*-variabele.
LETTERMINT_API_TOKEN=""
# Afzender; het domein moet in Lettermint geverifieerd zijn:
MAIL_FROM_EMAIL="info@xyte.be"
# Weergavenaam voor bestelmeldingen (inloglinks: "Vleeswaren Vermeir"):
MAIL_FROM_NAME="Bestellingen Vermeir"
# Adres van de zaak dat de bestelmelding ontvangt:
ORDER_NOTIFICATION_EMAIL="michel@xyte.be"

# ─────────────────────────────────────────────────────────────
# Error tracking (Panel, Sentry-compatibel)
# ─────────────────────────────────────────────────────────────
# DSN van Panel → Errors → "vleeswarenvermeir.be" → ingest-endpoint.
# Openbaar (komt in de browser-JS). Nodig tijdens de BUILD én tijdens runtime:
# enkel bij de build → server-fouten gaan stil verloren; enkel runtime →
# browserfouten.
SENTRY_DSN="https://pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@dashboard.xyte.be/api/ingest/1"

# Source maps naar Panel (scripts/upload-sourcemaps.mjs, draait na `nuxt build`).
# Enkel in de BUILD-omgeving van Dokploy, niet in je lokale .env. Zonder deze
# twee waarschuwt het script, uploadt het niets en verwijdert het de maps
# (ze worden nooit geserveerd); met slechts één van de twee faalt de build.
# PANEL_DEPLOY_KEY is geheim: nooit in client-code of een NUXT_PUBLIC_*-variabele.
# Er is bewust geen release-variabele: de git-commit wordt door @sentry/nuxt in
# de bundels gestempeld en het script leest hem daar terug uit.
# PANEL_URL="https://dashboard.xyte.be"
# PANEL_DEPLOY_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────
# Panel-analytics (pageviews)
# ─────────────────────────────────────────────────────────────
# Niet geheim, maar wordt tijdens de BUILD gelezen: een wijziging
# vergt een nieuwe build, geen herstart.
PANEL_ANALYTICS_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────
# Bestaande app-config
# ─────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_PASSWORD="vermeir2026"

# Eenmalige toegangslink voor één klant (omzeilt de site-lock via
# /toegang/<token>, zonder het algemene wachtwoord te delen). Leeg = uit.
NUXT_PUBLIC_CUSTOMER_ACCESS_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Productfiches (PDF)
# ─────────────────────────────────────────────────────────────
# Optioneel. In productie: het mountpad van het Dokploy-volume met de
# PDF's (map products/ erin), bv. /data/docs. Leeg = ./data/docs.
DOCS_DIR=
