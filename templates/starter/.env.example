# Two env files per site (both gitignored):
#   .env       DEVELOPMENT — the app reads this (pnpm dev, scripts, db:migrate).
#   .env.live  PRODUCTION values, for reference only — the app never reads it;
#              only `pnpm db:migrate:production` does (drizzle.production.config.ts).
# The live site gets its values from Vercel (Production). Vercel Preview gets
# the development values. See .claude/rules/integrations.md.

# ── Email (Lettermint, official SDK — see server/utils/mail.ts) ──────────────
# Project API token from the Lettermint dashboard, format lm_xxx. Server only.
LETTERMINT_API_TOKEN=
# Sender; its domain must be verified in Lettermint (SPF + DKIM).
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
# Who receives the contact form (server/api/contact.post.ts).
CONTACT_NOTIFICATION_EMAIL=
# Development + Preview only: EVERY mail goes to this address instead, with the
# real recipient in the subject. Leave empty in production.
MAIL_REDIRECT_TO=

# ── Neon (database) — only on sites that provision one ──────────────────────
# .env → the Neon branch "development"; .env.live → the "production" branch.
# Use the *pooled* URL (host contains "-pooler").
# DATABASE_URL=

# Shows the "DEVELOPMENT · TESTDATABASE" banner. Set to "development" in .env
# and on Vercel Preview; leave empty in production.
NUXT_PUBLIC_DATABASE_ENV=
