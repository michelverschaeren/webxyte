{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-async.sh",
            "shell": "bash",
            "asyncRewake": true,
            "timeout": 120,
            "statusMessage": "Linting in background"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-stop.sh",
            "shell": "bash",
            "timeout": 300,
            "statusMessage": "lint + typecheck"
          }
        ]
      }
    ]
  }
}
