# ─────────────────────────────────────────────────────────────
# Database (Neon Postgres) — twee bestanden
# ─────────────────────────────────────────────────────────────
# .env       = DEVELOPMENT: dit bestand, de app leest het (nuxt dev,
#              scripts, npm run db:migrate). Wijst naar de Neon-branch
#              "development" (kopie van productie).
# .env.live  = PRODUCTIE ter referentie: zelfde sleutels met de live
#              waarden. De app leest het NIET; enkel
#              npm run db:migrate:production (drizzle.production.config.ts).
# De live site zelf krijgt haar waarden uit Vercel (Production);
# Vercel Preview gebruikt de branch "development".
# Gebruik de *pooled* Neon-URL (host met "-pooler").
DATABASE_URL="postgresql://gebruiker:wachtwoord@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Toont een oranje kader met bovenaan "DEVELOPMENT · TESTDATABASE".
# Leeg laten in productie (.env.live / Vercel Production).
NUXT_PUBLIC_DATABASE_ENV="development"

# ─────────────────────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────────────────────
# Genereer met: openssl rand -base64 32
# (of PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256})))
BETTER_AUTH_SECRET="vervang-mij-door-een-random-string-van-32-bytes"

# Publieke basis-URL van de app. Lokaal http://localhost:3000,
# in productie de echte domeinnaam (https).
BETTER_AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# E-mail (Lettermint): bestelmeldingen + inloglinks
# ─────────────────────────────────────────────────────────────
# Optioneel lokaal: zolang deze leeg zijn wordt er geen mail verstuurd
# (bestellingen worden wél opgeslagen; inloglinks komen in de serverlog).
# In productie verplicht, anders werken inloglink/wachtwoord vergeten niet.
# Token: Lettermint → Projects → <project> → API Tokens (Project API token).
# Geheim: nooit in client-code of een NUXT_PUBLIC_*-variabele.
LETTERMINT_API_TOKEN=""
# Afzender; het domein moet in Lettermint geverifieerd zijn:
MAIL_FROM_EMAIL="info@xyte.be"
# Weergavenaam voor bestelmeldingen (inloglinks: "Vleeswaren Vermeir"):
MAIL_FROM_NAME="Bestellingen Vermeir"
# Adres van de zaak dat de bestelmelding ontvangt:
ORDER_NOTIFICATION_EMAIL="michel@xyte.be"
# Adres dat de berichten van het contactformulier ontvangt.
# Leeg = zelfde adres als ORDER_NOTIFICATION_EMAIL.
CONTACT_NOTIFICATION_EMAIL=""
# Adres dat de aanvragen "klant worden" (login-popup) ontvangt.
# Leeg = vleeswarenvermeir@telenet.be.
CUSTOMER_REQUEST_EMAIL=""
# Development/Preview: ALLE mail gaat naar dit adres (de echte ontvanger
# staat in het onderwerp). De development-database bevat echte klanten.
# Leeg laten in productie.
MAIL_REDIRECT_TO="web.xyte@outlook.com"

# ─────────────────────────────────────────────────────────────
# Productfiches (PDF)
# ─────────────────────────────────────────────────────────────
# Staan in een private bucket (Neon Object Storage, S3-compatibel), zie
# server/utils/product-docs.ts. Neon geeft de waarden als AWS_ENDPOINT_URL_S3,
# AWS_REGION, AWS_ACCESS_KEY_ID en AWS_SECRET_ACCESS_KEY; zet ze hier onder de
# S3_*-namen, want Vercel reserveert de AWS_*-namen. Het secret is geheim.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────
# Bezoekcijfers (Vercel Web Analytics) — beheerpagina "Bezoekers"
# ─────────────────────────────────────────────────────────────
# Token: Vercel → Account Settings → Tokens, met toegang tot het team van
# dit project. Geheim: nooit in client-code of een NUXT_PUBLIC_*-variabele.
# Leeg = de pagina meldt dat de cijfers nog niet gekoppeld zijn.
VERCEL_ANALYTICS_TOKEN=
